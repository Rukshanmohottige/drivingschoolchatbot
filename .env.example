# ==========================================
# DriveMate AI - Environment Configuration
# ==========================================

# (Optional) External AI Provider Keys
# If not provided, DriveMate uses its built-in high-accuracy grounded RAG engine out-of-the-box!
GEMINI_API_KEY=
OPENAI_API_KEY=

# (Optional) Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# (Optional) PostgreSQL / Supabase Database URL
# If empty, DriveMate stores bookings, enquiries, and sessions in local ./data/db.json
DATABASE_URL=
